# ─────────────────────────────────────────────────────────────────────────
# LMS Backend configuration. Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────────────────

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- Security -----------------------------------------------------------
# MUST match the RAG chatbot's JWT_SECRET_KEY: the shared secret is what
# lets a signed-in chatbot user walk into the LMS without logging in again.
SECRET_KEY=fallback-super-secret-key-for-local-dev-only
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ACTION_TOKEN_EXPIRE_HOURS=72
# Set to false only for local http development.
COOKIE_SECURE=false

# --- Database -----------------------------------------------------------
# The LMS keeps its tables in the `lms` schema, so it can share the
# chatbot's database without colliding with its `public.users` table.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meritech_db
DB_SCHEMA=lms
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Cache / rate limiting ---------------------------------------------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP=120
RATE_LIMIT_PER_TENANT=3000

# --- Background jobs ---------------------------------------------------
# Redis doubles as the broker locally (no RabbitMQ needed to run a worker);
# staging/production point this at Amazon MQ, e.g.
#   amqps://user:pass@b-xxxx.mq.eu-west-1.amazonaws.com:5671
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/1
ACCRUAL_CHUNK_SIZE=1000

# --- CORS (the chatbot origin must be listed to allow the SSO call) ----
BACKEND_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_BASE_URL=http://localhost:8001

# --- Email (leave notifications; unset = log instead of send) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@meritech.example

# --- Attachments (optional; unset disables document upload) ------------
S3_BUCKET=
S3_REGION=us-east-1
MAX_ATTACHMENT_MB=10

# --- Billing (optional) ------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
